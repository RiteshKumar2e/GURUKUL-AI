# Dependencies
node_modules/
**/node_modules/

# Environment files (examples stay tracked)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Build output
dist/
build/
coverage/
.cache/
.vite/
*.tsbuildinfo

# Logs
*.log*
*npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Uploads (keep the folder)
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Editor / tooling
.idea/
*.swp
graphify-out/

# Database backups and any stray local database files
backend/backups/
*.db
*.db-journal
*.db-wal
*.db-shm
