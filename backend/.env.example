NODE_ENV=development
PORT=5000

# PostgreSQL connection string
# Local (docker compose): postgresql://gurukul:gurukul_dev_password@localhost:5433/gurukul_ai?schema=public
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# AI provider (Groq, OpenAI-compatible API). Leave AI_API_KEY empty to run in clearly-labelled demo mode.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=https://api.groq.com/openai/v1
AI_VISION_MODEL=qwen/qwen3.8-27b
AI_STT_MODEL=whisper-large-v3
AI_TIMEOUT_MS=30000

# Tutor model choice: auto | groq | gemini
#   auto = Groq if AI_API_KEY is set, else Gemini if GEMINI_API_KEY is set, else demo mode
LLM_PROVIDER=auto
# Google Gemini (OpenAI-compatible endpoint). Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# Voice tutor (Hindi, English, Telugu)
#   STT_PROVIDER: auto | sarvam | groq | none   (auto = Sarvam if key, else Groq Whisper if key, else browser only)
#   TTS_PROVIDER: auto | sarvam | browser       (auto = Sarvam if key, else the device's own voice)
STT_PROVIDER=auto
TTS_PROVIDER=auto
# Sarvam AI key: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
VOICE_TIMEOUT_MS=30000

FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=6

# Cookie settings for the refresh token. Use SameSite=none + secure when frontend and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to true behind a TLS-terminating proxy (Render, Railway, Nginx) to enforce HTTPS redirects
ENFORCE_HTTPS=false
TRUST_PROXY=false
